<Window x:Class="Klavrio.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="520" SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Margin="18" Padding="26" CornerRadius="20"
            Background="{DynamicResource Klavrio.SurfaceBrush}"
            BorderBrush="{DynamicResource Klavrio.BorderBrush}" BorderThickness="1"
            materialDesign:ElevationAssist.Elevation="Dp5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="14" Margin="0,0,13,0"
                        Background="{DynamicResource Klavrio.AccentSoftBrush}">
                    <materialDesign:PackIcon Kind="Restore" Width="23" Height="23"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                </Border>
                <TextBlock x:Name="DialogTitle" VerticalAlignment="Center" FontSize="20"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,24">
                <TextBlock x:Name="DialogQuestion" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="DialogDetails" FontSize="13.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource Klavrio.MutedBrush}" LineHeight="21" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        FlowDirection="LeftToRight">
                <Button x:Name="CancelButton" Margin="0,0,10,0" MinWidth="104"
                        Style="{StaticResource Klavrio.SecondaryButton}" IsCancel="True"
                        Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton" MinWidth="104"
                        Style="{StaticResource Klavrio.PrimaryButton}" IsDefault="True"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
